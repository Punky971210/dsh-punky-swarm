// test/chain-v2-declaration.test.js —— **声明面 v2**（P4a-pre · Batch I Step 1）
// ─────────────────────────────────────────────────────────────────────────────
// 范围：只测 `lib/assembly/chain.js` 的**纯函数校验面**（`validateChain`）——新增键
//   `perLane`（分支配对：本步按上游步的每个 lane 实例化一份）与 `deps`（显式 DAG 边）。
//   实例化与推进语义在 `lib/engine/chain-runner.js`（Step 2），本文件**不涉**。
//
// 两条硬锁（本文件的回归目标）：
//   ① **v1 语义逐字不变**：v1 资产声明 `perLane`/`deps` ⇒ **拒**（`FIELD_NOT_ALLOWED`），
//      不静默接受、不悄悄改拓扑；
//   ② **v2 的 DAG 是合法拓扑**：无环 DAG ⇒ 不要求 `rework`（与 v1「回边须由 rework 承认」口径一致——
//      回边 = DFS 环，DAG 不产生回边）；成环 ⇒ `REWORK_INVALID`。
//
// 判据来源：`docs/chain-model-upgrade-spec-20260916.md §2.1/§3`。

import test from 'node:test';
import assert from 'node:assert/strict';

import { validateChain, CHAIN_VERSIONS, perLaneTargetOf, pairedLaneOf } from '../lib/assembly/chain.js';

const LAYERS = {
  plan: { roles: ['designer'] },
  exec: { roles: ['coder'] },
  audit: { roles: ['reviewer'] },
};

/** v2 参照模型（用户 2026-09-16 澄清的形态）：plan → exec →（每个 exec lane 配一个 audit 实例）→ 聚合验收。 */
const v2Model = () => ({
  version: 2,
  steps: [
    { id: 'plan', layer: 'plan', role: 'designer', next: 'exec' },
    { id: 'exec', layer: 'exec', role: 'coder', join: 'all', next: 'audit' },
    { id: 'audit', layer: 'audit', role: 'reviewer', perLane: 'exec', next: 'accept' },
    { id: 'accept', layer: 'audit', role: 'reviewer', join: 'all', terminal: true },
  ],
});

const codesOf = (problems) => problems.map((p) => p.code);

test('V2-1 参照模型：plan → exec →（perLane audit）→ 聚合 accept ⇒ 校验通过', () => {
  const r = validateChain(v2Model(), LAYERS);
  assert.equal(r.ok, true, '参照模型必须通过：' + JSON.stringify(r.problems));
  assert.deepEqual(r.problems, []);
});

test('V2-2 版本白名单：1|2 合法，其余拒（BAD_TYPE，零新造码）', () => {
  assert.deepEqual([...CHAIN_VERSIONS], [1, 2], '版本白名单 = [1,2]');
  for (const bad of [3, '2', null, undefined]) {
    const c = v2Model();
    c.version = bad;
    const r = validateChain(c, LAYERS);
    assert.equal(r.ok, false, `version=${JSON.stringify(bad)} 必须拒`);
    assert.ok(codesOf(r.problems).includes('TEAM_ASSET_BAD_TYPE'), '须报 TEAM_ASSET_BAD_TYPE');
  }
});

test('V2-3 硬锁①：v1 声明 perLane ⇒ 拒（FIELD_NOT_ALLOWED，不静默改拓扑）', () => {
  const c = v2Model();
  c.version = 1;
  const r = validateChain(c, LAYERS);
  assert.equal(r.ok, false, 'v1 + perLane 必须拒');
  assert.ok(codesOf(r.problems).includes('TEAM_ASSET_FIELD_NOT_ALLOWED'), '须报 FIELD_NOT_ALLOWED');
});

test('V2-4 硬锁①：v1 声明 deps ⇒ 拒（FIELD_NOT_ALLOWED）', () => {
  const c = v2Model();
  c.version = 1;
  c.steps[0].deps = ['exec'];
  const r = validateChain(c, LAYERS);
  assert.equal(r.ok, false, 'v1 + deps 必须拒');
  assert.ok(codesOf(r.problems).includes('TEAM_ASSET_FIELD_NOT_ALLOWED'), '须报 FIELD_NOT_ALLOWED');
});

test('V2-5 perLane 悬空 / 自指 ⇒ MISSING_FIELD（两态各自报码）', () => {
  const dangling = v2Model();
  dangling.steps[2].perLane = 'ghost';
  const r1 = validateChain(dangling, LAYERS);
  assert.equal(r1.ok, false);
  assert.ok(codesOf(r1.problems).includes('TEAM_ASSET_MISSING_FIELD'), '悬空目标 ⇒ MISSING_FIELD');

  const self = v2Model();
  self.steps[2].perLane = 'audit';
  const r2 = validateChain(self, LAYERS);
  assert.equal(r2.ok, false);
  assert.ok(codesOf(r2.problems).includes('TEAM_ASSET_MISSING_FIELD'), '自指 ⇒ MISSING_FIELD');
});

test('V2-6 deps 悬空 / 自指 / 重复 / 空数组 ⇒ 各自报码', () => {
  const dangling = v2Model();
  dangling.steps[3].deps = ['ghost'];
  assert.ok(codesOf(validateChain(dangling, LAYERS).problems).includes('TEAM_ASSET_MISSING_FIELD'), '悬空依赖');

  const self = v2Model();
  self.steps[3].deps = ['accept'];
  assert.ok(codesOf(validateChain(self, LAYERS).problems).includes('TEAM_ASSET_MISSING_FIELD'), '自指依赖');

  const dup = v2Model();
  dup.steps[3].deps = ['audit', 'audit'];
  assert.ok(codesOf(validateChain(dup, LAYERS).problems).includes('TEAM_ASSET_MISSING_FIELD'), '重复依赖');

  const empty = v2Model();
  empty.steps[3].deps = [];
  assert.ok(codesOf(validateChain(empty, LAYERS).problems).includes('TEAM_ASSET_BAD_TYPE'), '空数组 ⇒ BAD_TYPE');
});

test('V2-7 硬锁②：无环 DAG ⇒ 不要求 rework（不误报回边）', () => {
  const c = v2Model();
  c.steps[3].deps = ['plan', 'audit']; // 显式 DAG 边，仍无环
  const r = validateChain(c, LAYERS);
  assert.equal(r.ok, true, '无环 DAG 不得要求 rework：' + JSON.stringify(r.problems));
  assert.ok(!codesOf(r.problems).includes('TEAM_ASSET_REWORK_INVALID'));
});

test('V2-8 硬锁②：deps 成环 ⇒ REWORK_INVALID（环须由 rework 承认，与 v1 同口径）', () => {
  const cyclic = {
    version: 2,
    steps: [
      { id: 'a', layer: 'plan', role: 'designer', deps: ['b'], next: 'b' },
      { id: 'b', layer: 'exec', role: 'coder', terminal: true, deps: ['a'] },
    ],
  };
  const r = validateChain(cyclic, LAYERS);
  assert.equal(r.ok, false, '成环必须拒');
  assert.ok(codesOf(r.problems).includes('TEAM_ASSET_REWORK_INVALID'), '须报 REWORK_INVALID');
  // 且不得因成环而误报「孤儿步」（环内两步自首步均可达）
  assert.ok(!codesOf(r.problems).includes('TEAM_ASSET_MISSING_FIELD'),
    '成环不应连带误报孤儿步：' + JSON.stringify(r.problems));
});

test('V2-9 perLane 隐式入边计入可达性：上游未用 next 串接时仍不报孤儿步', () => {
  // audit 只靠 perLane 挂到 exec（无 exec.next）——v1 会判「不可达」；v2 必须视为可达
  const c = {
    version: 2,
    steps: [
      { id: 'plan', layer: 'plan', role: 'designer', next: 'exec' },
      { id: 'exec', layer: 'exec', role: 'coder', terminal: false },
      { id: 'audit', layer: 'audit', role: 'reviewer', perLane: 'exec', terminal: true },
    ],
  };
  const r = validateChain(c, LAYERS);
  assert.equal(r.ok, true, 'perLane 隐式入边须计入可达性：' + JSON.stringify(r.problems));
});

test('V2-10 v1 回归锁：v1 资产（单路径 + 双 exec lane 共享同一步）行为逐字不变', () => {
  const v1 = {
    version: 1,
    steps: [
      { id: 'plan', layer: 'plan', role: 'designer', next: 'exec' },
      { id: 'exec', layer: 'exec', role: 'coder', join: 'all', next: 'audit' },
      { id: 'audit', layer: 'audit', role: 'reviewer', terminal: true },
    ],
  };
  const r = validateChain(v1, LAYERS);
  assert.equal(r.ok, true, 'v1 参照链必须仍通过：' + JSON.stringify(r.problems));
  assert.deepEqual(r.problems, [], 'v1 零 problems（八条校验语义未变）');
});

// ── Step 2：两个纯函数拓扑查询（分支配对的**判定面**；推进语义在 chain-runner）──────────────
// 判据：配对**禁猜** —— 只认「目标 lane 的 `deps` 恰为 `[上游 lane]`」这一种形态；
//   其余（多依赖 / 无 deps / 顺序相邻）一律 `null`，由调用方**停轮上报**（不顺序兜底）。

test('V2-11 perLaneTargetOf：命中后继 perLane 步；无 perLane ⇒ null；自指不命中', () => {
  const c = v2Model();
  const hit = perLaneTargetOf(c, 'exec');
  assert.ok(hit && hit.id === 'audit', 'exec 的后继 audit 声明 perLane:exec ⇒ 必须命中');
  assert.equal(perLaneTargetOf(c, 'plan'), null, 'plan 没有 perLane 后继 ⇒ null');
  assert.equal(perLaneTargetOf({ version: 2, steps: [{ id: 'a', perLane: 'a' }] }, 'a'), null, '自指不得命中');
  assert.equal(perLaneTargetOf(null, 'x'), null, '非法入参 ⇒ null（不抛）');
});

test('V2-12 pairedLaneOf：只认 deps 恰为 [上游 lane]；多依赖/无 deps/缺 lane 一律 null（禁猜）', () => {
  const targetLanes = ['audit_1', 'audit_2'];
  const tasks = [
    { id: 'exec_1', layer: 'exec', role: 'coder' },
    { id: 'audit_1', layer: 'audit', role: 'reviewer', deps: ['exec_1'] },
    { id: 'audit_2', layer: 'audit', role: 'reviewer', deps: ['exec_2'] },
  ];
  assert.equal(pairedLaneOf(targetLanes, 'exec_1', tasks), 'audit_1', 'deps 单元素精确匹配');
  assert.equal(pairedLaneOf(targetLanes, 'exec_2', tasks), 'audit_2', '另一条分支各归各（不串台）');

  const multi = [...tasks, { id: 'audit_3', layer: 'audit', role: 'reviewer', deps: ['exec_1', 'exec_2'] }];
  assert.equal(pairedLaneOf(['audit_3'], 'exec_1', multi), null, '多依赖 ≠ 配对（禁猜，须停轮）');
  assert.equal(pairedLaneOf(['exec_1'], 'exec_1', tasks), null, '目标 lane 集内无 deps 命中 ⇒ null');
  assert.equal(pairedLaneOf(targetLanes, 'exec_9', tasks), null, '上游 lane 无对应配对 ⇒ null');
  assert.equal(pairedLaneOf(targetLanes, '', tasks), null, '空上游 lane ⇒ null（不抛）');
});
