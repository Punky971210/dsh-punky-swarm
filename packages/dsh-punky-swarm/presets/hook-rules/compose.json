      "narrow": [ { "path": "/timeoutMs", "max": 120000 } ]
    },
    {
      "id": "L2-R03",
      "tools": ["ssh_cluster"],
      "match": { "path": "/timeoutMs", "op": "gt", "value": 300000 },
