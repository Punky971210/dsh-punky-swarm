    {
      "id": "L2-R01",
      "tools": ["pwsh"],
      "match": { "path": "/timeoutMs", "op": "gt", "value": 600000 },
      "violations": [
        { "code": "L2-R01", "category": "narrowable", "path": "/timeoutMs",
          "message": "[preset L2] pwsh timeoutMs 超过上限 600000ms：请按收窄指引重试" }
      ],
      "narrow": [ { "path": "/timeoutMs", "max": 600000 } ]
    },
    {
      "id": "L2-R02",
      "tools": ["ssh_exec"],
