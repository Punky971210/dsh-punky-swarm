{
  "name": "dsh-punky-swarm",
  "version": "0.6.0",
  "type": "module",
  "description": "dsh-punky-swarm — dsh 插件（DeepSeek Harness）· punky 署名 · 集群治理（swarm governance）引擎：单机多子 agent 治理，wavePlan 三层 DAG + 引擎级门禁（Entry / Plan Contract / Exit / Complete）+ 状态机 + 单写者锁 + 会话隔离 + 国标 AIP 兼容 + 全能力治理增强。附蟛蜞模式预设与 software-team 角色指引。",
  "license": "AGPL-3.0-only",
  "icon": "./puncat.jpg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./provider-dsh": "./lib/provider-dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml",
    "puncat.jpg",
    "LICENSE",
    "README.md",
    "scripts",
    "!scripts/audit/out"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --import ./test/helpers/isolated-home.preload.mjs --test test/*.test.js && node scripts/evidence-guard.mjs",
    "fragility": "node scripts/audit/fragility.mjs",
    "fragility:selftest": "node scripts/audit/fragility.mjs --selftest",
    "smoke:host": "node scripts/smoke/host-smoke.mjs",
    "quantity:scan": "node scripts/neighbor-scan.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "swarm",
    "cluster",
    "governance",
    "orchestration",
    "tier3",
    "gates"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": "0.2.x"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Punky971210/dsh-punky-swarm.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-app-boot": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
