{
  "name": "dsh-punky-swarm",
  "version": "0.5.5",
  "type": "module",
  "description": "dsh-punky-swarm — dsh 插件（DeepSeek Harness）· punky 署名 · 集群治理（swarm governance）引擎：单机多子 agent 治理，wavePlan 三层 DAG + 引擎级门禁（Entry / Plan Contract / Exit / Complete）+ 状态机 + 单写者锁 + 会话隔离 + 国标 AIP 兼容 + 全能力治理增强。附蟛蜞模式预设与 software-team 角色指引。",
  "license": "AGPL-3.0-only",
  "icon": "./puncat.jpg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./service-probe": "./lib/service-probe.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml",
    "puncat.jpg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "scripts",
    "!scripts/audit/out"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ts-built.mjs",
    "test": "npm run build && node --test test/*.test.js && node scripts/evidence-guard.mjs",
    "smoke:host": "node scripts/smoke/host-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "swarm",
    "cluster",
    "governance",
    "orchestration",
    "tier3",
    "gates"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Punky971210/dsh-punky-swarm.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
