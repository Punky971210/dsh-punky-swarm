{
  "name": "dsh-punky-swarm",
  "version": "0.4.0",
  "type": "module",
  "description": "dsh-punky-swarm — dsh 插件（DeepSeek Harness）· punky 署名 · 集群治理（swarm governance）引擎：单机多子 agent 治理，wavePlan 三层 DAG + 引擎级门禁（Entry / Plan Contract / Exit / Complete）+ 状态机 + 锁/mailbox + 会话隔离 + 国标 AIP 兼容 + 全能力治理增强。附蟛蜞模式预设与 jiufeng-team 角色指引。",
  "license": "AGPL-3.0-only",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/governance-boundaries.md",
    "docs/governance-boundaries.en.md",
    "docs/governance-technical.md",
    "docs/governance-technical.en.md",
    "docs/guardrails-hook.md",
    "docs/guardrails-hook.en.md",
    "docs/single-machine-capabilities.md",
    "docs/single-machine-capabilities.en.md",
    "docs/aip-compliance.md",
    "docs/aip-compliance.en.md",
    "docs/acps-communication.md",
    "docs/acps-communication.en.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ts-built.mjs",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "swarm",
    "cluster",
    "governance",
    "orchestration",
    "tier3",
    "gates"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Punky971210/dsh-punky-swarm"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
