{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "<ckpt_name: sd_xl_base_1.0.safetensors>" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "<positive>", "clip": ["1", 1] } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "<negative>", "clip": ["1", 1] } },
  "4": { "class_type": "EmptyLatentImage", "inputs": { "width": "<width: 1024>", "height": "<height: 1536>", "batch_size": 1 } },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["4", 0],
      "seed": "<seed>",
      "steps": "<steps: 24>",
      "cfg": "<cfg: 6.5>",
      "sampler_name": "<sampler_name: euler>",
      "scheduler": "<scheduler: normal>",
      "denoise": 1.0
    }
  },
  "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
  "7": { "class_type": "SaveImage", "inputs": { "images": ["6", 0], "filename_prefix": "<filename_prefix>" } },
  "8": { "class_type": "LoadImage", "inputs": { "image": "<cn_ref_image>" } },
  "9": { "class_type": "Canny", "inputs": { "image": ["8", 0], "low_threshold": 0.3, "high_threshold": 0.7 } },
  "10": { "class_type": "ControlNetLoader", "inputs": { "control_net_name": "<cn_model: diffusion_pytorch_model_promax.safetensors>" } },
  "11": { "class_type": "SetUnionControlNetType", "inputs": { "control_net": ["10", 0], "type": "<cn_type: canny/lineart/anime_lineart/mlsd>" } },
  "12": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["11", 0],
      "image": ["9", 0],
      "vae": ["1", 2],
      "strength": "<cn_strength: 0.7>",
      "start_percent": "<cn_start_percent: 0.0>",
      "end_percent": "<cn_end_percent: 1.0>"
    }
  }
}
